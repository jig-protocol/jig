[Unit]
Description=jig-nameserver (DID/handle registry, tailnet-only)
Documentation=file:/opt/jig/deploy/README.md

# Same reboot trap as jig-server: the nameserver binds a Tailscale 100.x
# address, which does not exist until tailscaled has brought the interface up.
# Without this ordering the unit fails on every reboot with EADDRNOTAVAIL.
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

# Deliberately a separate process from jig-server on the same host: different
# port, different database, different blast radius. /v1/register has NO
# authentication beyond proof-of-control of a self-minted key, so it must never
# be reachable off the tailnet.
After=jig-server.service

[Service]
Type=simple
User=jig
Group=jig

Restart=on-failure
RestartSec=5s

# Optional (leading '-'): the nameserver needs no secret. Put any JIG_NS_*
# setting you want kept out of this unit in a chmod 600 root:jig file here
# (unit files are readable by anyone who can run `systemctl cat`). A
# JIG_NS_SECRET left in it from an older install is ignored.
EnvironmentFile=-/etc/jig/jig-nameserver.env

# `jig-nameserver serve --bind/--port` are honoured as of the v0.0.2 alias-API
# work — main.rs passes them into run_http_server and they override the loaded
# config. These env vars are equivalent and are applied after any TOML config,
# so they win over a stray ~/.jig/config.toml.
# Either mechanism works; pick one and stay with it.
#
# ⚠️ YOU MUST REPLACE THE BIND ADDRESS BELOW. Unlike jig-server — which takes
# `bind_address` from /etc/jig/config.toml — the nameserver's bind lives here in
# the unit, so it is easy to install this file and never notice it is unset.
# The value must be a LITERAL tailnet IP (`tailscale ip -4`), not a hostname and
# not a placeholder: the bind goes through getaddrinfo, so anything unresolvable
# fails with "failed to lookup address information: Name or service not known"
# and systemd will crash-loop on it indefinitely. An earlier placeholder of
# `100.x.y.z` looked plausibly like an address and cost 600 restarts to spot.
Environment=JIG_NS_BIND=REPLACE_WITH_TAILNET_IPV4
Environment=JIG_NS_PORT=7070
# Anchors the file names only: the nameserver keeps nameserver_v002.db and
# nameserver_v002.key next to this path and never creates nameserver.db itself.
Environment=JIG_NS_DB_PATH=/var/lib/jig/nameserver.db
Environment=JIG_NS_CONFIG=/etc/jig/jig-nameserver.toml
# Pin HOME so config discovery cannot wander into another account's ~/.jig.
Environment=HOME=/var/lib/jig

# The secret that opens the nameserver's sealed key (nameserver_v002.jigkey),
# as for jig-server. Uncomment this AND [v0_0_2.keys] unlock in
# jig-nameserver.toml together: either one alone fails the boot.
#LoadCredentialEncrypted=jig-nameserver-key:/etc/credstore.encrypted/jig-nameserver-key

ExecStart=/opt/jig/bin/jig-nameserver serve

WorkingDirectory=/var/lib/jig
StateDirectory=jig
StateDirectoryMode=0750
UMask=0077

# --- hardening -------------------------------------------------------------
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/jig

# DELIBERATELY NOT SET: MemoryDenyWriteExecute — see jig-server.service.
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
