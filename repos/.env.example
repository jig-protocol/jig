# Jig Protocol - Environment Variables
# Copy this file to .env and fill in required values.
# Every variable below is optional.

# ─── Nameserver (jig-nameserver) ───────────────────────────────────────────

# Bind address (default: 127.0.0.1)
# JIG_NS_BIND=0.0.0.0

# Port (default: 7070)
# JIG_NS_PORT=7070

# Database path (default: nameserver.db)
# JIG_NS_DB_PATH=/var/lib/jig/nameserver.db

# Admin token for protected admin endpoints (optional)
# JIG_NS_ADMIN_TOKEN=

# ─── Server (jig-server) ────────────────────────────────────────────────────

# Database path for jig-server (default: ~/.jig/jig.db)
# JIG_DB_PATH=/var/lib/jig/jig.db

# ─── Optional overrides ────────────────────────────────────────────────────

# Rate limiting (per key, per minute, default: 60)
# JIG_NS_RATE_PER_MIN=60

# Enable federation (default: false)
# JIG_NS_FEDERATION_ENABLED=false

# Config file path (overrides auto-discovery)
# JIG_NS_CONFIG=/etc/jig/nameserver.toml
