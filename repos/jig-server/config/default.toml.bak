# jig-server/config/default.toml
# Default configuration installed via curl
# License: AGPL-3.0

[server]
# Core server settings
bind = "127.0.0.1"
port = 7777
public_url = "https://localhost:7777"

# Federation enabled by default (key differentiator)
federation_enabled = true
anonymous_allowed = true  # No registration required

[storage]
# Zero-dependency mode - just SQLite
backend = "sqlite"
path = "~/.jig/jig.db"

# Optional backends (require additional setup)
# backend = "postgres"
# backend = "ipfs"  # For distributed storage

[protocols]
# All protocols enabled in default install
jig_native = true      # WSS on :7777
irc_compat = true      # IRC on :6667
ssh_transport = true   # SSH on :2222

# Email bridge - enabled but needs configuration
[protocols.email]
enabled = false  # User must configure MX records first
smtp_port = 25
submission_port = 587
imap_enabled = false  # Optional, heavier

[email]
# Email bridge configuration
smtp_enabled = false  # Set true after MX setup
imap_enabled = false  # Set true for email client support

# Relay configuration (for sending)
[email.relay]
# Start with community relay (free)
primary = "community"

# Participate in community relay network
community_relay = true
donated_quota = 100  # Donate 100 emails/month back

# Uncomment for SendGrid (recommended for production)
# primary = "sendgrid"
# api_key = "YOUR_SENDGRID_API_KEY"

# Uncomment for direct send (requires clean IP)
# primary = "direct"

# MX domains this server handles
mx_domains = []  # Add your domains here

[discovery]
# DNS auto-discovery
enabled = true
cache_ttl = 3600

# Well-known endpoint
wellknown_enabled = true

[encryption]
# E2E encryption by default
enabled = true
algorithm = "curve25519-xsalsa20-poly1305"

[federation]
# Federation settings
enabled = true
public_relay = true  # Act as relay for others

# Known relays (bootstrap)
bootstrap_relays = [
    "relay.jig.onl",
    "federation.jig.email",
]

[limits]
# Reasonable defaults for self-hosted
max_message_size = "10MB"
max_file_size = "100MB"
rate_limit = 100  # messages per minute

[plugins]
# Plugin system (MIT licensed plugins only)
enabled = true
directory = "~/.jig/plugins"

# ============================================
# SENSITIVE: Commercial features
# These require a commercial license
# ============================================

# [gigue]
# enabled = false
# license_key = ""
# 
# # AI features (Gigue exclusive)
# [gigue.ai]
# enabled = false
# model = "gpt-4"
# 
# # Rich blocks (Gigue exclusive)
# [gigue.blocks]
# enabled = false
# 
# # Enterprise features
# [gigue.enterprise]
# sso_enabled = false
# audit_log = false
# compliance_mode = false